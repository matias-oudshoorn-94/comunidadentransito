APP_NAME="Comunidad en Tránsito"
# local | production. En local, si no hay credenciales de pago, se usa un pago simulado.
APP_ENV=local
APP_DEBUG=true
# URL pública, sin barra final. Mercado Pago y PayPal vuelven a esta dirección.
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Argentina/Buenos_Aires

# sqlite (desarrollo) | mysql (producción)
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comunidad_en_transito
DB_USERNAME=root
DB_PASSWORD=

# log (guarda los emails en storage/logs/mail.log) | mail (usa mail() de PHP)
MAIL_DRIVER=log
MAIL_FROM=hola@comunidadentransito.com

# Mercado Pago · https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_CURRENCY=ARS

# PayPal · https://developer.paypal.com/dashboard/applications
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
